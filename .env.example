# Domain for this WordPress site
WORDPRESS_DOMAIN=photo.madsnorgaard.net

# MySQL credentials
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_USER=wordpress
MYSQL_PASSWORD=change_me_password
MYSQL_DATABASE=wordpress

# Shared secret for the Nuxt BFF (X-Internal-Token header): bypasses the
# REST rate limit and authorizes event-archive/v1 writes. Generate long
# random (e.g. openssl rand -hex 32); must match the Nuxt container env.
PHOTO_API_INTERNAL_TOKEN=change_me_long_random
